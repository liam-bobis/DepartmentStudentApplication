<div id="<%= dom_id department %>">
  <p>
    <strong>Name:</strong>
    <%= department.name %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= department.location %>
  </p>

  <p>
    <strong>Student Count:</strong>
    <%= department.students.count %>
  </p>

  <p>
    <strong>Teacher Count:</strong>
    <%= department.teachers.count %>
  </p>

  <p>
    <strong>Laboratory:</strong>
    <%= department.laboratory %>
  </p>
</div>
